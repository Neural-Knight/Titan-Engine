# CMake build directories
build/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
# Only ignore CMake-generated Makefiles inside build dirs, not our root Makefile.
build/Makefile
cmake-build-*/Makefile
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
install_manifest.txt
Testing/
CMakeUserPresets.json

# clangd / editor tooling caches
.cache/
.clangd/

# Coverage and profiling instrumentation output
*.gcda
*.gcno
*.profraw
*.profdata

# perf (Linux) output, if a bench is profiled in-place
perf.data
perf.data.old

# Stray build/test logs left in the repo instead of /tmp
*.log

# Compiled objects and binaries
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.out

# macOS
.DS_Store

# Editors and IDEs
.vscode/
.idea/
*.swp
